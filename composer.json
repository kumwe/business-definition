{
  "name": "kumwe/business-definition",
  "description": "Immutable business definitions, bounded formula semantics, validation and compatibility.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/business-definition",
  "support": {
    "issues": "https://github.com/kumwe/business-definition/issues",
    "source": "https://github.com/kumwe/business-definition"
  },
  "require": {
    "php": "^8.5",
    "php-64bit": "*",
    "kumwe/localization": "0.1.0",
    "kumwe/sequence": "0.2.0",
    "psr/container": "^2.0",
    "ramsey/uuid": "^4.9"
  },
  "require-dev": {
    "ext-zip": "*",
    "laminas/laminas-servicemanager": "^4.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Kumwe\\BusinessDefinition\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kumwe\\BusinessDefinition\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "composer:validate": "composer validate --strict",
    "release:check": "bash tools/test-release-record.sh",
    "lint": "php tools/lint.php",
    "docs": "php tools/check-docblocks.php",
    "architecture": "php tools/verify-architecture.php",
    "manifests": "php tools/verify-manifests.php",
    "manifests:record": "php tools/verify-manifests.php --write",
    "autoload:smoke": "php resources/toolchain/autoload-smoke.php",
    "examples": "php examples/definition.php",
    "cs": "phpcs -q",
    "cs:fix": "phpcbf",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "test": "phpunit",
    "clean-consumer": "php tools/verify-clean-consumer.php",
    "check": [
      "@composer:validate",
      "@security:audit",
      "@release:check",
      "@lint",
      "@docs",
      "@architecture",
      "@manifests",
      "@autoload:smoke",
      "@examples",
      "@cs",
      "@analyse",
      "@test",
      "@clean-consumer",
      "@release:integrity",
      "@test:ownership"
    ],
    "security:audit": "composer audit --abandoned=fail",
    "release:integrity": "bash tools/test-release-integrity.sh",
    "test:ownership": "php tools/verify-test-ownership.php --self-test"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
